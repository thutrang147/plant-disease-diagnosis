# Large datasets and generated data
data/raw/
data/processed/
data/interim/

# Model checkpoints
models/
checkpoints/
*.pth
*.pt
*.ckpt

# Local environment
.venv/
__pycache__/
.DS_Store
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.cache/

# Local credentials; example environment templates may be versioned.
.env
.env.*
!.env.example
.aws/
.ssh/
.netrc

# New generated results stay local; existing tracked evidence remains tracked.
outputs/

# Third-party evaluation images (local only)
/data/external_evaluation/tomato_field_eval_v1/images/

# Evaluation v2 images and raw crop parents stay local (including third-party photos).
/data/external_evaluation/tomato_field_eval_v2/images/
/data/external_evaluation/tomato_field_eval_v2/provenance/parents/

# Also exclude evaluation photos inside accidentally nested upstream packages.
/data/external_evaluation/**/images/

# Evaluation packages are private by default, including full annotated manifests,
# source photographs, review workbooks and build-time validation snapshots.
/data/external_evaluation/*

# Keep v2 self-contained while exposing only reviewed reusable code/documentation.
!/data/external_evaluation/tomato_field_eval_v2/
/data/external_evaluation/tomato_field_eval_v2/*
!/data/external_evaluation/tomato_field_eval_v2/build_dataset.py
!/data/external_evaluation/tomato_field_eval_v2/validate_dataset.py
!/data/external_evaluation/tomato_field_eval_v2/class_mapping.json
!/data/external_evaluation/tomato_field_eval_v2/README.md

# Fresh re-runs written by scripts/reproduce_round2.sh
reproduction/
